{
    "name": "edwin-ortizp/laravel-markdown",
    "description": "Framework-independent Markdown editor UI and safe viewer for Laravel Blade, with optional Livewire 3/4 integration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/commonmark": "^2.8"
    },
    "suggest": {
        "livewire/livewire": "Optional Livewire 3 or 4 integration"
    },
    "autoload": {
        "psr-4": {
            "Edwin\\LaravelMarkdown\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edwin\\LaravelMarkdown\\MarkdownServiceProvider"
            ]
        }
    },
    "keywords": [
        "laravel",
        "markdown",
        "blade",
        "livewire",
        "editor"
    ],
    "homepage": "https://github.com/edwin-ortizp/laravel-markdown",
    "support": {
        "issues": "https://github.com/edwin-ortizp/laravel-markdown/issues",
        "source": "https://github.com/edwin-ortizp/laravel-markdown"
    }
}
